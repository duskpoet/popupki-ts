# Copy to `.env` and fill in. Loaded by dotenv at startup and by prisma.config.ts.

# --- Required ---------------------------------------------------------------

# Telegram bot token from @BotFather
BOT_TOKEN=123456789:replace-with-your-bot-token

# PostgreSQL connection string. This value matches `docker compose up -d db`.
DATABASE_URL=postgresql://eduard@ep-black-smoke-890925.eu-central-1.aws.neon.tech/main?sslmode=require&channel_binding=require

# --- Optional: webhook mode -------------------------------------------------
# Leave PORT and HOST unset for local development; the bot then long-polls.
# When both are set, the bot registers `${HOST}/telegram` as its webhook and
# listens on PORT. HOST must be the public https origin, no trailing slash.

# PORT=8080
# HOST=https://popupki.fly.dev

# Secret token Telegram sends with every webhook request. If unset, a random
# one is generated per boot (fine for a single instance, since the webhook is
# re-registered on every start). Allowed characters: A-Z a-z 0-9 _ -
# WEBHOOK_SECRET=

# --- Optional: debugging ----------------------------------------------------
# Trace Telegram requests, polling and webhooks to stderr.
# DEBUG=node-telegram-bot-api:*
