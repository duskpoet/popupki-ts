generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Popupka {
  id     Int    @id @default(autoincrement())
  name   String @unique
  chatId String
  Check  Check?

  @@index([chatId])
}

model Check {
  id        Int     @id @default(autoincrement())
  popupkaId Int     @unique
  popupka   Popupka @relation(fields: [popupkaId], references: [id], onDelete: Cascade)

  @@index([popupkaId])
}
